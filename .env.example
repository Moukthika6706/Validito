# --- Application ---
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# --- Database (MySQL) ---
# DATABASE_URL overrides the MYSQL_* parts when set, e.g. sqlite:///./dev.db for a no-MySQL dev loop.
# DATABASE_URL=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=validito
MYSQL_USER=validito
MYSQL_PASSWORD=validito
MYSQL_ROOT_PASSWORD=root

# --- Queue (Redis / Celery) ---
REDIS_URL=redis://localhost:6379/0
# Run pipeline tasks inline in the API process (no worker / Redis needed). Dev and tests only.
CELERY_TASK_ALWAYS_EAGER=false

# --- Storage ---
STORAGE_DIR=./storage
# local | db  (db mirrors uploads into the stored_files table for hosts with an ephemeral disk)
STORAGE_BACKEND=local
MAX_UPLOAD_MB=25

# --- ML / OCR ---
OCR_LANGUAGES=en
OCR_USE_GPU=false
SPACY_MODEL=en_core_web_sm
ML_MODEL_DIR=./app/ml/artifacts

# --- LLM-assisted extraction fallback (OFF by default) ---
# When enabled and a key is set, Claude is asked for required fields the extractor missed.
# Proposals must appear verbatim in the document text; they are stored as source "llm" with a
# low confidence and always route the document to human review.
LLM_FALLBACK_ENABLED=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_TIMEOUT_SECONDS=20
LLM_MAX_INPUT_CHARS=12000
LLM_CONFIDENCE=0.45

# --- Notifications (both channels OFF by default) ---
# Triggered when a document is routed to review or any flag reaches NOTIFY_SEVERITY_THRESHOLD.
# Delivery runs on the Celery "notifications" queue with retries; failures are audited and
# never affect the document.
FRONTEND_BASE_URL=http://localhost:5173
NOTIFY_SEVERITY_THRESHOLD=error
NOTIFY_DEDUPE_PER_DOCUMENT=true
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
NOTIFY_EMAIL_FROM=validito@localhost
NOTIFY_EMAIL_TO=
NOTIFY_SLACK_ENABLED=false
SLACK_WEBHOOK_URL=

# --- Rendering ---
# Build the API image with LibreOffice so DOCX files render as pages in the review screen.
INSTALL_LIBREOFFICE=false

# --- Review ---
REVIEW_CLAIM_TTL_MINUTES=30

# --- Routing default (rule packs override) ---
AUTO_APPROVE_CONFIDENCE=0.85

# --- Docker seed behaviour ---
SEED_DEMO_DATA=true
SEED_SAMPLES=1
