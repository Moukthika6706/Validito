# --- Application ---
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# --- Database (MySQL) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=validito
MYSQL_USER=validito
MYSQL_PASSWORD=validito
MYSQL_ROOT_PASSWORD=root

# --- Queue (Redis / Celery) ---
REDIS_URL=redis://localhost:6379/0

# --- Storage ---
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# --- ML / OCR ---
OCR_LANGUAGES=en
OCR_USE_GPU=false
ML_MODEL_DIR=./app/ml/artifacts

# --- Routing thresholds (defaults; rule packs may override) ---
AUTO_APPROVE_CONFIDENCE=0.85
