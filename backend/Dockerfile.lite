# Lite Validito API image: no PyTorch / EasyOCR, so it fits a 512 MB host (Render free tier).
# Scanned images are rejected with a clear message; text PDFs and DOCX work fully.
# Celery runs inline (CELERY_TASK_ALWAYS_EAGER=true), so no worker or Redis is needed.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends netcat-openbsd curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install -r requirements.txt \
    && python -m spacy download en_core_web_sm

COPY . .
RUN chmod +x docker-entrypoint.sh

EXPOSE 8000
ENTRYPOINT ["./docker-entrypoint.sh"]
CMD ["api"]
