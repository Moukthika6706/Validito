# Copy to .env on the server:  cp .env.production.example .env   then edit the values.
# Used by docker-compose.yml + docker-compose.prod.yml. Never commit the real .env.

# --- Secrets (REQUIRED) ---
# Generate with:  openssl rand -hex 32
SECRET_KEY=
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# --- Public address of the app (your EC2 public DNS or domain, no trailing slash) ---
# Used for CORS and for deep links in notifications / reports.
FRONTEND_BASE_URL=http://ec2-xx-xx-xx-xx.compute-1.amazonaws.com
CORS_ORIGINS=http://ec2-xx-xx-xx-xx.compute-1.amazonaws.com

# --- Demo data ---
# true  -> first boot creates the three demo accounts and processes the sample term sheets
# false -> empty database; register the first admin via POST /api/v1/users after creating one manually
SEED_DEMO_DATA=true
SEED_SAMPLES=1
# Let sign-up choose a role (demo convenience). Keep false in production: admins assign roles.
ALLOW_SELF_ROLE_SELECTION=false

# --- Optional features (all off by default) ---
INSTALL_LIBREOFFICE=false
NOTIFY_EMAIL_ENABLED=false
NOTIFY_SLACK_ENABLED=false
LLM_FALLBACK_ENABLED=false
# ANTHROPIC_API_KEY=
